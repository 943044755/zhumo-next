# Neon Postgres 连接串（https://neon.tech 创建项目后复制；留空则使用本地 data/tasks.json 文件存储）
DATABASE_URL=

# 允许跨域访问本 API 的来源（逗号分隔；同源部署（默认）用不到，仅前后端分离部署时需要；留空 = 不限制）
ALLOWED_ORIGINS=

# 仅前后端分离部署且不同域名时才需要：前端从哪个地址拉 API（留空 = 同源，即 Next.js 自带的 /api）
NEXT_PUBLIC_API_BASE=
# 访问口令（部署 Vercel 必配，否则数据无保护）
# 会话签名密钥（部署 Vercel 必配：openssl rand -hex 32 生成）
AUTH_SECRET=
